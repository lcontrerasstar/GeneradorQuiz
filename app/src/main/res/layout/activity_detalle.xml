<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".DetalleActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <ImageView
            android:id="@+id/imgQuizDetalle"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_logo_quiz"
            android:contentDescription="@string/desc_icono_quiz" />

        <TextView
            android:id="@+id/txtTituloDetalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/quiz1_titulo"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtCategoriaDetalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/det_categoria"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txtDificultadDetalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/det_dificultad"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txtPreguntasDetalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/det_preguntas"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txtPuntajeDetalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/det_mejor_puntaje"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtLblEjemplo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/det_lbl_ejemplo"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtPreguntaEjemplo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/det_pregunta_ejemplo"
            android:textSize="16sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swFavoritoDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:checked="true"
            android:text="@string/sw_favorito" />

        <Button
            android:id="@+id/btnJugarDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/btn_jugar_quiz" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnEditarDetalle"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_editar" />

            <Button
                android:id="@+id/btnEliminarDetalle"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="@string/btn_eliminar" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>