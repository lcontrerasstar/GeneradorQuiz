<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".RegistroActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:id="@+id/txtTituloRegistro"
            style="@style/TituloPantalla"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/titulo_registro"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/txtSubtituloRegistro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/subtitulo_registro"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/edtNombreRegistro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="12dp"
            android:hint="@string/hint_nombre"
            android:inputType="textPersonName"
            android:autofillHints="username" />

        <EditText
            android:id="@+id/edtCorreoRegistro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="12dp"
            android:hint="@string/hint_correo"
            android:inputType="textEmailAddress"
            android:autofillHints="emailAddress" />

        <EditText
            android:id="@+id/edtClaveRegistro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="12dp"
            android:hint="@string/hint_clave"
            android:inputType="textPassword"
            android:autofillHints="password" />

        <EditText
            android:id="@+id/edtRepetirClaveRegistro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="12dp"
            android:hint="@string/hint_repetir_clave"
            android:inputType="textPassword"
            android:autofillHints="password" />

        <TextView
            android:id="@+id/txtPreguntaRegistro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/pregunta_registro"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgUsoQuiz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbEstudiar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/rb_estudiar" />

            <RadioButton
                android:id="@+id/rbEnsenar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rb_ensenar" />

            <RadioButton
                android:id="@+id/rbEntretencion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rb_entretencion" />
        </RadioGroup>

        <CheckBox
            android:id="@+id/chkTerminosRegistro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/chk_terminos" />

        <Button
            android:id="@+id/btnCrearCuenta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/btn_crear_cuenta" />

        <TextView
            android:id="@+id/txtIrLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:minHeight="48dp"
            android:gravity="center"
            android:text="@string/txt_ir_login"
            android:textColor="?attr/colorPrimary" />
    </LinearLayout>
</ScrollView>